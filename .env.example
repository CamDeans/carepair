# CarePair mobile (Expo) — copy to `mobile/.env` for local dev. Never commit secrets.
#
# Reference: `mobile/app.config.ts` (build-time / prebuild), `mobile/src/lib/config.ts` (runtime).
#
# EXPO_PUBLIC_* — inlined into the JS bundle when Metro or EAS Build runs; use non-secret values only.
# GOOGLE_MAPS_* / SENTRY_ORG / SENTRY_PROJECT / EAS_PROJECT_ID — read when app.config evaluates
#   (local prebuild or EAS Build). Prefer EAS Secrets for CI/store builds.
#
# GitHub repo + EAS linking: see **`README.md`** in this folder (`eas init`, `EAS_PROJECT_ID`, etc.).

# -----------------------------------------------------------------------------
# Expo CLI (local only)
# -----------------------------------------------------------------------------
# Default `npm start` sets EXPO_NO_DEPENDENCY_VALIDATION (via package.json) so Metro starts
# when expo.dev is unreachable (firewall/VPN/offline). Use `npm run start:strict` to allow
# Expo’s remote dependency version check. If you still see fetch errors, use `npm run start:offline`.

# -----------------------------------------------------------------------------
# Required for a real device talking to your machine (dev)
# -----------------------------------------------------------------------------
# Full API root including `/api` — must match how the server mounts routes.
#   iOS Simulator:     http://localhost:3001/api
#   Android emulator:  http://10.0.2.2:3001/api
#   Physical device:   http://YOUR_LAN_IP:3001/api (same Wi‑Fi; firewall open on PORT)
# Production EAS build: https://your-api.example.com/api
EXPO_PUBLIC_API_URL=http://192.168.1.27:3001/api

# -----------------------------------------------------------------------------
# EAS / Expo push (store builds)
# -----------------------------------------------------------------------------
# Project UUID from https://expo.dev — required for real push / EAS project linkage.
EAS_PROJECT_ID=

# -----------------------------------------------------------------------------
# Google Sign-In (Google Cloud Console OAuth clients)
# -----------------------------------------------------------------------------
# Web client ID must match server `GOOGLE_CLIENT_ID`.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# -----------------------------------------------------------------------------
# Google Maps (native only — not EXPO_PUBLIC_*; keeps keys out of the JS bundle)
# -----------------------------------------------------------------------------
# Set before `expo prebuild` or EAS Build. Restrict keys by bundle id / SHA-1 in Google Cloud.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=

# -----------------------------------------------------------------------------
# Sentry (optional)
# -----------------------------------------------------------------------------
# Client DSN — safe as EXPO_PUBLIC_ (Sentry docs).
EXPO_PUBLIC_SENTRY_DSN=
# Send events while __DEV__ (default off without this).
# EXPO_PUBLIC_SENTRY_DEBUG=1

# Build-time plugin config in app.config.ts (source maps / org linkage). Set on EAS, not in repo:
#   SENTRY_AUTH_TOKEN   — secret; use EAS Secret (https://docs.expo.dev/guides/using-sentry/)
#   SENTRY_ORG=
#   SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Stripe (optional client fallback)
# -----------------------------------------------------------------------------
# Billing portal URL if the app uses the portal fallback (see subscription screen copy).
EXPO_PUBLIC_STRIPE_PORTAL_URL=

# -----------------------------------------------------------------------------
# Staff portal (in-app; no extra EXPO_PUBLIC_* keys)
# -----------------------------------------------------------------------------
# Access is decided by the API (roles + server env allowlists). See `server/.env.example`:
#   STAFF_ADMIN_EMAILS, STAFF_TEAM_EMAILS, VALUED_TESTER_MAX
#
# In the app: Settings → Staff portal (when the signed-in user has portal access).
#
# Custom URL scheme matches `scheme` in app.config.ts (default: carepair). Examples:
#   carepair:///staff-portal
#   carepair:///staff-portal/team-access
# (Three slashes keep the path as `/staff-portal` for Expo Linking.)
#
# Push payloads (string values): `deepLink` = `/staff-portal`, or `staffPortal` = `1`.
# Implemented in `mobile/src/lib/notificationDeepLink.ts`.

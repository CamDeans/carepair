{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_PROJECT_ID": "780ad853-e5b6-441d-985e-6f346ec16060",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EAS_PROJECT_ID": "780ad853-e5b6-441d-985e-6f346ec16060",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_VERBOSE_CLIENT_LOGS": "1"
      }
    },
    "internal-testflight": {
      "extends": "production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_VERBOSE_CLIENT_LOGS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_PROJECT_ID": "780ad853-e5b6-441d-985e-6f346ec16060",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production-play": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
